{
  "name": "tau-extensions",
  "description": "Tau Repository for Dion Extensions",
  "icon": "https://placehold.co/256x256/EEE/31343C.png?text=Tau+Extensions",
  "id": "38a22e47-ccc5-4cdb-a461-ec43861b1f21",
  "url": "https://github.com/HashMarvinHash/tau",
  "repository": {
    "url": "https://github.com/HashMarvinHash/tau"
  },
  "private": true,
  "scripts": {
		"build": "turbo run build",
		"test": "turbo run test",
		"lint": "turbo run lint",
		"format": "turbo run format",
		"check-types": "turbo run check-types",
		"create": "bunx dion-create",
		"build-index": "bunx dion-build-index",
		"dev": "turbo run build && bunx dion-build-index && bunx serve .index",
		"build-site": "dion-build-index && dion-build-site"
	},
  "devDependencies": {
    "turbo": "2.11.13",
    "typescript": "catalog:",
    "@dion-js/extension-scripts": "catalog:",
    "@biomejs/biome": "catalog:",
    "@types/bun": "catalog:"
  },
  "engines": {
    "bun": "^1.3.14"
  },
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "extensions/*"
  ],
  "catalog": {
    "@dion-js/runtime-types": "0.15.0",
    "@dion-js/extension-types": "0.15.0",
    "@dion-js/runtime": "3.0.1",
    "@dion-js/config": "0.1.0",
    "@dion-js/runtime-lib": "0.14.0",
    "@dion-js/extension-scripts": "0.8.0",
    "@dion-js/extension-test-utils": "0.4.0",
    "typescript": "7.0.2",
    "@biomejs/biome": "2.6.8",
    "@types/bun": "1.4.5",
    "valibot": "1.5.0"
  },
  "overrides": {
    "@dion-js/runtime-types": "0.15.0",
    "@dion-js/extension-types": "0.15.0",
    "@dion-js/runtime": "3.0.1",
    "@dion-js/config": "0.1.0",
    "@dion-js/runtime-lib": "0.14.0",
    "@dion-js/extension-scripts": "0.8.0",
    "@dion-js/extension-test-utils": "0.4.0"
  }
}
